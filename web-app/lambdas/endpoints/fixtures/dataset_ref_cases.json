      "datasets": {},
      "expected": [
        {"id": "r1", "sort": 1, "step_type": "repeat", "instruction": "Users", "dataset_id": "",
         "repeat_columns": ["email"], "repeat_rows": [["a@x.test"]]},
        {"id": "c1", "sort": 2, "step_type": "navigation", "instruction": "x", "parent_step_id": "r1"}
      ],
      "fetched": []
