{
  "name": "ops",
  "description": "Root cause analyst and production investigator. Builds timelines from evidence, never guesses, always documents.",
  "prompt": "file://ops-prompt.md",
  "tools": [
    "@creds-agent",
    "glob",
    "grep",
    "read",
    "shell",
    "todo_list",
    "use_aws",
    "web",
    "web_fetch",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "use_aws",
    "grep",
    "glob",
    "@creds-agent"
  ],
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "echo '--- Ops Context ---' && (cat AGENTS.md 2>/dev/null || echo 'No AGENTS.md') && echo '---' && (ls docs/incidents/ 2>/dev/null || echo 'No previous incidents') && echo '---' && (git log --oneline -5 2>/dev/null || echo 'No git history')"
      },
      "timeout": 5
    }
  ],
  "welcomeMessage": "Ops mode. What's happening? Give me the symptoms and I'll investigate.",
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "creds-agent/*"
        ],
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "mcpServers": {
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ],
      "env": {
        "AIM_CREDS_AGENT_URL_KIRO": "${AIM_CREDS_AGENT_URL}",
        "AIM_CREDS_AGENT_INJECTION": "7f93ba1b-fc2a-4d46-b086-26936dcb69b9"
      }
    }
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:11402e00eea882ef27a7c5dbf6d8cae1209316d1e110fb11fecc7b29bd5881d8",
    "source": "sha256:5a1d4522e28eeca847c824bb167c451f8b2f5717ebec2c7e18d6ba32db8a5f93"
  }
}
